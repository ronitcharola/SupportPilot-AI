# ==========================================
# SupportPilot AI Environment Configuration
# ==========================================

# Environment Mode: development | test | production
ENVIRONMENT=development

# Demo Mode: Uses mock providers, seeded data, and mock external services
DEMO_MODE=true

# Security & Authentication
# Generate in production via: openssl rand -hex 32
SECRET_KEY=dev-super-secret-key-change-in-production-min-32-chars-supportpilot
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# In Docker / Production:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/supportpilot
# In Local Developer Mode without Docker (uncomment to use):
# DATABASE_URL=sqlite+aiosqlite:///./supportpilot.db

# Redis & Celery Worker
REDIS_URL=redis://redis:6379/0
# In Local Developer Mode without Redis:
# REDIS_URL=redis://localhost:6379/0

# AI Provider Settings: mock | openai | gemini
LLM_PROVIDER=mock
LLM_MODEL=mock-gpt-4o
EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSION=1536
# Production cosine cutoff for real providers
SIMILARITY_THRESHOLD=0.72
# Mock embeddings are lexical sketches and use their own calibrated cutoff
MOCK_SIMILARITY_THRESHOLD=0.12
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_LLM_MODEL=gemini-1.5-flash

# AI triage (Phase 4)
# Classifications below this confidence are auto-flagged for human review
AI_LOW_CONFIDENCE_THRESHOLD=0.55

# Knowledge base / RAG
# inline = index during the request (works without Redis); celery = use the worker
KNOWLEDGE_INGESTION_MODE=inline
MAX_UPLOAD_BYTES=5242880
KNOWLEDGE_CHUNK_SIZE=900
KNOWLEDGE_CHUNK_OVERLAP=150
RETRIEVAL_SCAN_LIMIT=2000

# Real Provider API Keys (optional if LLM_PROVIDER=mock)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Storage Backend: local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads

# Frontend URL & CORS
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
